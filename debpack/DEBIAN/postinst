#!/bin/bash
set -e

chown -R nagios:nagios /etc/check_wmi_plus
java -cp /usr/lib/nagios/plugins/ibmi/nagios4i.jar com.ibm.nagios.config.Initialization

# Need to fix ownership of the plugins we place
chown -R root:root /usr/lib/nagios/plugins/

# The monit config file is included in nems-scripts
# Restart in case anything changed
/bin/systemctl restart monit

# check_fortigate
cpan -i Net::SNMP
cpan -i List::Compare
cpan -i Getopt::Long
cpan -i Pod::Usage
cpan -i Switch
cpan -i JSON

# Python modules required by check_netscaler.py
# These are already installed on NEMS Linux
# - JSON
# - Monitoring::Plugin

# Check_ESXI_*
# ----------------------------------------------------------------------
# Set up a dedicated virtual environment to safely install pywbem and
# updated dependencies without conflicting with Debian system packages.
# ----------------------------------------------------------------------
VENV_DIR="/opt/nems-venv"

# Ensure Debian's python3-venv helper is installed
if ! dpkg -s python3-venv >/dev/null 2>&1; then
    apt-get update
    apt-get install -y python3-venv python3-pip
fi

# Create virtual environment if it doesn't exist
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv --system-site-packages "$VENV_DIR"
fi

# Upgrade pip and install pywbem in the isolated environment
"$VENV_DIR/bin/pip" install --upgrade pip
"$VENV_DIR/bin/pip" install pywbem
# ----------------------------------------------------------------------


# check_snmp

# Detect the UID of the nagios user (fallback to 1001 if user query fails)
NAGIOS_USER="nagios"
NAGIOS_UID=$(id -u "$NAGIOS_USER" 2>/dev/null || echo "1001")

# Build target state path expected by check_snmp
TARGET_DIR="/usr/var/${NAGIOS_UID}"

# Create the path structure
mkdir -p "$TARGET_DIR"

# Ensure nagios user owns /usr/var and the UID subfolder
if id "$NAGIOS_USER" >/dev/null 2>&1; then
    chown -R "$NAGIOS_USER:$NAGIOS_USER" /usr/var
fi

# Set proper working permissions for state file creation
chmod 775 "$TARGET_DIR"

# / check_snmp


exit 0
